      "text": "يَٰٓأَيُّهَا ٱلَّذِينَ ءَامَنُوٓاْ إِذَا نُودِيَ لِلصَّلَوٰةِ مِن يَوۡمِ ٱلۡجُمُعَةِ فَٱسۡعَوۡاْ إِلَىٰ ذِكۡرِ ٱللَّهِ وَذَرُواْ ٱلۡبَيۡعَۚ ذَٰلِكُمۡ خَيۡرࣱ لَّكُمۡ إِن كُنتُمۡ تَعۡلَمُونَ ۝٩",
      "sha256": "f7aa8a7ded7e83bd136c4acd8904dce61b5d97be030bdac149213cd35bc4327b"
    },
    {
      "surah": 65,
      "ayah": 3,
      "text": "وَيَرۡزُقۡهُ مِنۡ حَيۡثُ لَا يَحۡتَسِبُۚ وَمَن يَتَوَكَّلۡ عَلَى ٱللَّهِ فَهُوَ حَسۡبُهُۥٓۚ إِنَّ ٱللَّهَ بَٰلِغُ أَمۡرِهِۦۚ قَدۡ جَعَلَ ٱللَّهُ لِكُلِّ شَيۡءࣲ قَدۡرࣰا ۝٣",
      "sha256": "b6e28c3bda9be3f92bf7b312132c809d155a8e3c30a61c8791ebad3faf4888d7"
    },
    {
      "surah": 67,
      "ayah": 5,
      "text": "وَلَقَدۡ زَيَّنَّا ٱلسَّمَآءَ ٱلدُّنۡيَا بِمَصَٰبِيحَ وَجَعَلۡنَٰهَا رُجُومࣰا لِّلشَّيَٰطِينِۖ وَأَعۡتَدۡنَا لَهُمۡ عَذَابَ ٱلسَّعِيرِ ۝٥",
      "sha256": "3478bb731af4eb5d8510d0d569ae9856d1af471a43395cbc7d4430627dab1492"
    },
    {
      "surah": 89,
      "ayah": 27,
      "text": "يَٰٓأَيَّتُهَا ٱلنَّفۡسُ ٱلۡمُطۡمَئِنَّةُ ۝٢٧",
      "sha256": "7bbfaa0d8c7b433399618e76d3c33a3be3e6bc86278e57ef137e78838965e4d3"
    },
    {
      "surah": 89,
      "ayah": 28,
      "text": "ٱرۡجِعِيٓ إِلَىٰ رَبِّكِ رَاضِيَةࣰ مَّرۡضِيَّةࣰ ۝٢٨",
      "sha256": "4601370173536ec193bbcc5b8d64542635c867da2cc7f9466e5f0d5aa1004749"
    },
    {
      "surah": 89,
      "ayah": 29,
      "text": "فَٱدۡخُلِي فِي عِبَٰدِي ۝٢٩",
      "sha256": "61cd0d8eda400891f907729cc48eb7e503b5396ba18df2c817e2173bd1d80a60"
    },
    {
      "surah": 89,
      "ayah": 30,
      "text": "وَٱدۡخُلِي جَنَّتِي ۝٣٠",
      "sha256": "93054cbc493615fa4e80ef3fc0fe8c67a238708d1d99f5a69a2cdb79d9308de8"
    },
    {
      "surah": 93,
      "ayah": 3,
      "text": "مَا وَدَّعَكَ رَبُّكَ وَمَا قَلَىٰ ۝٣",
      "sha256": "8523b524a8d8567b66d381c05ac05952b13924ad9588180517237666d3b7fb85"
    },
    {
      "surah": 93,
      "ayah": 4,
      "text": "وَلَلۡأٓخِرَةُ خَيۡرࣱ لَّكَ مِنَ ٱلۡأُولَىٰ ۝٤",
      "sha256": "887e1839249ac088f81d66132899273efd43caf10546dd45f4de6693cb548f22"
    },
    {
      "surah": 93,
      "ayah": 5,
      "text": "وَلَسَوۡفَ يُعۡطِيكَ رَبُّكَ فَتَرۡضَىٰٓ ۝٥",
      "sha256": "0bd5c073ab407aa1ce1a5b5a93ad826fb49a3454b508832c66a60003e38df433"
    },
    {
      "surah": 94,
      "ayah": 5,
      "text": "فَإِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرًا ۝٥",
      "sha256": "8a4ab07f51d846867795de41db1d486c0c5202938777297cd41cf4aa75273291"
    },
    {
      "surah": 94,
      "ayah": 6,
      "text": "إِنَّ مَعَ ٱلۡعُسۡرِ يُسۡرࣰا ۝٦",
      "sha256": "d6351815ea33d53e590e9e13cfe9525c15cfa37e1eddc3ccd3b32230e78575f7"
    },
    {
      "surah": 94,
      "ayah": 7,
      "text": "فَإِذَا فَرَغۡتَ فَٱنصَبۡ ۝٧",
      "sha256": "29c962730a236190e62bb70195d756e121da4547217ba5428bb1453db14476af"
    },
    {
      "surah": 94,
      "ayah": 8,
      "text": "وَإِلَىٰ رَبِّكَ فَٱرۡغَب ۝٨",
      "sha256": "32ccedb8f4516285f021aa80e56336dc4b6b038e19e7bb6967cc71665cc9b20c"
    },
    {
      "surah": 103,
      "ayah": 1,
      "text": "وَٱلۡعَصۡرِ ۝١",
      "sha256": "80d63c39f8778ffd20ba63bfa848519cddb5bcde763905a63f9c76ff71e5643d"
    },
    {
      "surah": 103,
      "ayah": 2,
      "text": "إِنَّ ٱلۡإِنسَٰنَ لَفِي خُسۡرٍ ۝٢",
      "sha256": "bb87f7f455f8670539ea90f230bf573b6ebc3e3da64d972993aaaeefbf7420d1"
    },
    {
      "surah": 103,
      "ayah": 3,
      "text": "إِلَّا ٱلَّذِينَ ءَامَنُواْ وَعَمِلُواْ ٱلصَّٰلِحَٰتِ وَتَوَاصَوۡاْ بِٱلۡحَقِّ وَتَوَاصَوۡاْ بِٱلصَّبۡرِ ۝٣",
      "sha256": "e590e44e288c79e52bc84482104cf890634110e1b3ff0ba5ba5efafb22c05adf"
    },
    {
      "surah": 108,
      "ayah": 1,
      "text": "إِنَّآ أَعۡطَيۡنَٰكَ ٱلۡكَوۡثَرَ ۝١",
      "sha256": "adae8e8bc34d7938198d339cf3af4f20dc794d682bdb2b2805962f40a0ace29b"
    },
    {
      "surah": 108,
      "ayah": 2,
      "text": "فَصَلِّ لِرَبِّكَ وَٱنۡحَرۡ ۝٢",
      "sha256": "82400da4781332c888ba0faf615326c3fbd39ca50f3f2b5faf41a94063471021"
    },
    {
      "surah": 108,
      "ayah": 3,
      "text": "إِنَّ شَانِئَكَ هُوَ ٱلۡأَبۡتَرُ ۝٣",
      "sha256": "e49604f6b47d0e12a12b62c6228d221f32d0c51db50b29dbe4391d5aaf5bf9b5"
    },
    {
      "surah": 112,
      "ayah": 1,
      "text": "قُلۡ هُوَ ٱللَّهُ أَحَدٌ ۝١",
      "sha256": "5915386417328035e257c1c54ab664258bf9f7dbc2c5c8434dab8f70afd20b3a"
    },
    {
      "surah": 112,
      "ayah": 2,
      "text": "ٱللَّهُ ٱلصَّمَدُ ۝٢",
      "sha256": "a52e77af2e3c3e091ca6c8ee5181f0bb8fa49e7af9effba2a4b72bc8eb5205aa"
    },
    {
      "surah": 112,
      "ayah": 3,
      "text": "لَمۡ يَلِدۡ وَلَمۡ يُولَدۡ ۝٣",
      "sha256": "1580ac1a8cc14eabc91df6e53b0f89fd984448c4298b48efb7902281f4567a94"
    },
    {
      "surah": 112,
      "ayah": 4,
      "text": "وَلَمۡ يَكُن لَّهُۥ كُفُوًا أَحَدُۢ ۝٤",
      "sha256": "2f75d74fbf3d13c29660d17ba69a1632a29e26e01b8aaff28e96ddf22b768b29"
    },
    {
      "surah": 113,
      "ayah": 1,
      "text": "قُلۡ أَعُوذُ بِرَبِّ ٱلۡفَلَقِ ۝١",
      "sha256": "5ff73d0133bf100e31dbf052c7389d4f56cee0897f35d47b7fa6894b52dfec4a"
    },
    {
      "surah": 113,
      "ayah": 2,
      "text": "مِن شَرِّ مَا خَلَقَ ۝٢",
      "sha256": "57e84000a6e624a0ebdde5d6e4992d534a97e5d6e99cb4bbe372fce8b10ee654"
    },
    {
      "surah": 113,
      "ayah": 3,
      "text": "وَمِن شَرِّ غَاسِقٍ إِذَا وَقَبَ ۝٣",
      "sha256": "dc5f6ef5b82c0a46c1a913ac2a359d137b100735e93518c133a855b7080f1bb6"
    },
    {
      "surah": 113,
      "ayah": 4,
      "text": "وَمِن شَرِّ ٱلنَّفَّٰثَٰتِ فِي ٱلۡعُقَدِ ۝٤",
      "sha256": "b4420216b800a1718e4b6b164ce9fdcb87889cd3a41b3053b4f69fedfcea927e"
    },
    {
      "surah": 113,
      "ayah": 5,
      "text": "وَمِن شَرِّ حَاسِدٍ إِذَا حَسَدَ ۝٥",
      "sha256": "eb30c09ed6f8a6b40a05b6ba384a964e55f034ee917972390e6e3c195b572ba4"
    },
    {
      "surah": 114,
      "ayah": 1,
      "text": "قُلۡ أَعُوذُ بِرَبِّ ٱلنَّاسِ ۝١",
      "sha256": "20a60eea75d7308b69c51cda4c0f58ab952fc2e1fb9617a457700a786777047e"
    },
    {
      "surah": 114,
      "ayah": 2,
      "text": "مَلِكِ ٱلنَّاسِ ۝٢",
      "sha256": "3872f60ceb2530c6e04b4aafe757c06dd7e33edafa682c800acab864aae1c56a"
    },
    {
      "surah": 114,
      "ayah": 3,
      "text": "إِلَٰهِ ٱلنَّاسِ ۝٣",
      "sha256": "a7525469cd742975ef05eaae2017f410bfc3bf3b9d5937b7b336c438628aefa3"
    },
    {
      "surah": 114,
      "ayah": 4,
      "text": "مِن شَرِّ ٱلۡوَسۡوَاسِ ٱلۡخَنَّاسِ ۝٤",
      "sha256": "dd0b8d91d1d2667db18f3bb5f4491769b20ae205a6af6ce671881475a75788ec"
    },
    {
      "surah": 114,
      "ayah": 5,
      "text": "ٱلَّذِي يُوَسۡوِسُ فِي صُدُورِ ٱلنَّاسِ ۝٥",
      "sha256": "587c1ec9c17890a6951ed2a5c0c4466e1909df24178d19d077195ee4aacfe1bb"
    },
    {
      "surah": 114,
      "ayah": 6,
      "text": "مِنَ ٱلۡجِنَّةِ وَٱلنَّاسِ ۝٦",
      "sha256": "e36369263254306efcb44d0681df61fa1b1a007f910ea6212098f8b0addf0b86"
    }
  ]
}
