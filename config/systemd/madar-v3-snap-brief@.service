[Unit]
Description=Madar isolated requested daily brief
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/madar/current
ExecStart=/opt/madar/current/.venv/bin/python -m snap_bot.brief %i
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_UNIX
CapabilityBoundingSet=
ReadWritePaths=/var/lib/madar/snap
MemoryMax=3G
TimeoutStartSec=600
