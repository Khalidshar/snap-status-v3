[Unit]
Description=Madar status on-demand Quran asset preparation
[Service]
Type=oneshot
User=root
Group=ubuntu
WorkingDirectory=/opt/madar/current
ExecStartPre=+/usr/bin/systemctl start madar-v3-quran-retention@status.service
ExecStart=/opt/madar/current/.venv/bin/python -m status_bot.quran_clip prepare-command --root /var/lib/madar/quran-status --job %i
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/etc/madar
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/madar/quran-status
MemoryMax=512M
TimeoutStartSec=900
