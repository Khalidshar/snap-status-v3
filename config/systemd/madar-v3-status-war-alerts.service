[Unit]
Description=Madar status war-only alert check
ConditionPathExists=/etc/madar/war-alerts.enabled
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/madar/current
EnvironmentFile=/etc/madar/status-whatsapp.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/madar/current/.venv/bin/python -m status_bot.war_alerts --policy /opt/madar/current/config/alerts/war.toml --config /opt/madar/current/config/status/commands.toml --news-config /opt/madar/current/config/status/news.toml
UMask=0077
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/madar/status
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
TimeoutStartSec=150
Restart=no
