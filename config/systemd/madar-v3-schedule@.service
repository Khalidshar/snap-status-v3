[Unit]
Description=Madar scheduled clip %i in both bots (owner decision 9 Nov 2026)
After=madar-v3-snap-commands.service madar-v3-status-commands.service
[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/madar/current
ExecStart=/opt/madar/current/.venv/bin/python scripts/ops/schedule_tick.py %i
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/etc/madar
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/madar/snap /var/lib/madar/status
TimeoutStartSec=6000
MemoryMax=256M
