[Unit]
Description=Madar %i Quran asset lifetime worker (does not schedule content)
[Service]
Type=simple
User=root
WorkingDirectory=/opt/madar/current
ExecStart=/opt/madar/current/.venv/bin/python -m %i_bot.quran_clip retention --root /var/lib/madar/%i/quran
Environment=PYTHONDONTWRITEBYTECODE=1
UMask=0077
NoNewPrivileges=yes
PrivateNetwork=yes
RestrictAddressFamilies=AF_UNIX
InaccessiblePaths=-/run/madar -/etc/madar
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
ReadWritePaths=/var/lib/madar/%i/quran
MemoryMax=128M
