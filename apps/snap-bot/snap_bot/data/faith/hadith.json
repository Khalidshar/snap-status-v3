  "sacred": true,
  "kind": "hadith",
  "source_repo": "Khalidshar/status-bot@b445281",
  "items": [
    {
      "id": "bukhari_1",
      "text": "إِنَّمَا الأَعْمَالُ بِالنِّيَّاتِ، وَإِنَّمَا لِكُلِّ امْرِئٍ مَا نَوَى",
      "source": "صحيح البخاري • حديث 1",
      "grade": "صحيح",
      "sha256": "43ba59723e919896d19e854d1fe5a1d26c9e51a43048babbfe4470261e194e20"
    },
    {
      "id": "muslim_2564",
      "text": "لا تَحَاسَدُوا، ولا تَنَاجَشُوا، ولا تَبَاغَضُوا، ولا تَدَابَرُوا، ولا يَبِعْ بَعْضُكُمْ علَى بَيْعِ بَعْضٍ، وكُونُوا عِبَادَ اللَّهِ إخْوَانًا",
      "source": "صحيح مسلم • حديث 2564",
      "grade": "صحيح",
      "sha256": "b9f2327adca2dfc7a1de48d1519f90998f4a2b60f00cdce29b4f5215c0751799"
    },
    {
      "id": "bukhari_6018",
      "text": "مَن كانَ يُؤْمِنُ باللَّهِ واليَومِ الآخِرِ فَلْيَقُلْ خَيْرًا أوْ لِيَصْمُتْ",
      "source": "صحيح البخاري • حديث 6018",
      "grade": "صحيح",
      "sha256": "f6592b33a7ec9e19022499a0db7a8e5fb8a937646d21456be7b08e1afba1433b"
    },
    {
      "id": "muslim_2699",
      "text": "مَن سَلَكَ طَرِيقًا يَلْتَمِسُ فيه عِلْمًا، سَهَّلَ اللَّهُ له به طَرِيقًا إلى الجَنَّةِ",
      "source": "صحيح مسلم • حديث 2699",
      "grade": "صحيح",
      "sha256": "65c9695c31638be1b4d12468eeae38408786d0984d3412b09c2d2fd09a741790"
    },
    {
      "id": "bukhari_13",
      "text": "لا يُؤْمِنُ أحَدُكُمْ حتَّى يُحِبَّ لِأَخِيهِ ما يُحِبُّ لِنَفْسِهِ",
      "source": "صحيح البخاري • حديث 13",
      "grade": "صحيح",
      "sha256": "dcf6a16873e66a252704b6a29559bce92a06a2b17cf85383be1e1733d2571d7c"
    },
    {
      "id": "muslim_2319",
      "text": "مَن لا يَرْحَمْ لا يُرْحَمْ",
      "source": "صحيح مسلم • حديث 2319",
      "grade": "صحيح",
      "sha256": "69a7e9fac553f806560d6427b94af575b1f896adc70dfe1eddf9191ffc7aabe9"
    },
    {
      "id": "bukhari_6114",
      "text": "لَيْسَ الشَّدِيدُ بالصُّرَعَةِ، إنَّما الشَّدِيدُ الذي يَمْلِكُ نَفْسَهُ عِنْدَ الغَضَبِ",
      "source": "صحيح البخاري • حديث 6114",
      "grade": "صحيح",
      "sha256": "e5fcad94ac9873d66bd87aea30b8a4746dfe7088c0bd510d31dfa87863a98525"
    },
    {
      "id": "muslim_41",
      "text": "المُسْلِمُ مَن سَلِمَ المُسْلِمُونَ مِن لِسانِهِ ويَدِهِ",
      "source": "صحيح مسلم • حديث 41",
      "grade": "صحيح",
      "sha256": "8ea3e54ca703014f222945bf7bc35a68e57959e9ec6a8b5881d3bb0c65069092"
    }
  ]
}
